{
  "name": "quick-pass-emissions-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent public website for Quick Pass Emissions in Conyers, Georgia",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:publish": "node scripts/build.mjs --publish",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/content.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "axe-core": "4.11.0",
    "sharp": "0.35.5"
  }
}
